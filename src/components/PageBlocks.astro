---
import Hero from "./blocks/Hero.astro";
import PainPoints from "./blocks/PainPoints.astro";
import PositioningBanner from "./blocks/PositioningBanner.astro";
import Process from "./blocks/Process.astro";
import CtaBand from "./blocks/CtaBand.astro";
import PageHero from "./blocks/PageHero.astro";
import Bio from "./blocks/Bio.astro";
import Timeline from "./blocks/Timeline.astro";
import FeatureCards from "./blocks/FeatureCards.astro";
import TextSection from "./blocks/TextSection.astro";
import Recommendations from "./blocks/Recommendations.astro";
import NumberedList from "./blocks/NumberedList.astro";
import Plans from "./blocks/Plans.astro";
import ContactSection from "./blocks/ContactSection.astro";

// Tina returns __typename like "PageBlocksHero"; the JSON uses _template "hero".
const BLOCKS: Record<string, any> = {
  hero: Hero,
  painPoints: PainPoints,
  positioningBanner: PositioningBanner,
  process: Process,
  ctaBand: CtaBand,
  pageHero: PageHero,
  bio: Bio,
  timeline: Timeline,
  featureCards: FeatureCards,
  textSection: TextSection,
  recommendations: Recommendations,
  numberedList: NumberedList,
  plans: Plans,
  contactSection: ContactSection,
};
const keyOf = (b: any): string => {
  if (b?._template) return b._template;
  const k = String(b?.__typename ?? "").replace(/^PageBlocks/, "");
  return k.charAt(0).toLowerCase() + k.slice(1);
};

import { tinaField } from "@tinacms/astro/tina-field";
import { getMenuLabels } from "../lib/tina/data";
import { labelFor } from "../lib/nav";

const { page } = Astro.props as { page: any };
const blocks: any[] = page?.blocks ?? [];
// Breadcrumb is automatic: "<Home's Menu Label> / <this page's Menu Label>".
const saved = await getMenuLabels();
const slug = page?._sys?.filename ?? "";
const crumb = {
  home: labelFor("home", saved),
  page: page?.menuLabel?.trim() || labelFor(slug, saved),
  field: page ? tinaField(page, "menuLabel") : undefined,
};
---
{blocks.map((block) => {
  const Cmp = BLOCKS[keyOf(block)];
  return Cmp ? <Cmp {...block} block={block} crumb={crumb} /> : null;
})}
