---
import HeaderContent from "./HeaderContent.astro";
import { getMenuLabels } from "../lib/tina/data";

// Site-wide header. Labels come from each page's "Menu Label" field;
// addresses stay in code (src/lib/nav.ts).
export interface Props { active?: string; }
const { active = "" } = Astro.props;
const labels = await getMenuLabels();
---
<header class="site-header">
  <HeaderContent labels={labels} active={active} />
</header>
