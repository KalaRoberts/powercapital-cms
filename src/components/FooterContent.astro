---
import { tinaField } from "@tinacms/astro/tina-field";
import { navItems } from "../lib/nav";
const { settings, labels } = Astro.props as { settings: any; labels?: any };
const tagline = settings?.footerTagline;
const links = navItems(labels);
const year = new Date().getFullYear();
---
  <div class="container">
    <div class="footer-grid">
      <div>
        <a class="brand" href="/" style="margin-bottom:16px">
          <img src="/assets/img/logo-rich.png" alt="Power Capital logo" style="height:40px" />
          <span>Power Capital<span class="brand-sub">Fractional CFO</span></span>
        </a>
        {tagline && <p data-tina-field={tinaField(settings, "footerTagline")}>{tagline}</p>}
        <a href="https://www.linkedin.com/in/jmroberts67/" target="_blank" rel="noopener" style="color:#fff;font-size:1.3rem"><i class="fa-brands fa-linkedin"></i></a>
      </div>
      <div class="footer-col">
        <h4>Explore</h4>
        <ul>
          {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
        </ul>
      </div>
      <div class="footer-col">
        <h4>Get in touch</h4>
        <ul>
          <li><a href="/contact">Contact us by web form</a></li>
          <li><a href="https://www.linkedin.com/in/jmroberts67/" target="_blank" rel="noopener">LinkedIn</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <span>&copy; {year} Power Capital. All rights reserved.</span>
      <span>Designed and built by <a href="https://kalaroberts.github.io/" target="_blank" rel="noopener">Kala Roberts</a></span>
    </div>
  </div>
