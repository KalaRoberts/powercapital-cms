---
export interface Props {
  eyebrow?: string;
  heading?: string;
  lead?: string;
  cards?: { title: string; body: string }[];
}
const { eyebrow, heading, lead, cards = [] } = Astro.props;
---
<section>
  <div class="container">
    <div class="section-head">
      {eyebrow && <span class="eyebrow">{eyebrow}</span>}
      {heading && <h2>{heading}</h2>}
      {lead && <p class="lead">{lead}</p>}
    </div>
    <div class="grid grid-3">
      {cards.map((c) => (
        <div class="pain reveal"><h3>{c.title}</h3><p>{c.body}</p></div>
      ))}
    </div>
  </div>
</section>
