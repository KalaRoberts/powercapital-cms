---
import { tinaField } from "@tinacms/astro/tina-field";
const {
  eyebrow, heading,
  ctaPrimaryLabel, ctaPrimaryHref,
  ctaSecondaryLabel, ctaSecondaryHref,
  stats = [], portrait, portraitAlt,
  badgeTop, badgeBottom, block,
} = Astro.props as any;
const f = (name: string) => (block ? tinaField(block, name) : undefined);
---
<section class="hero">
  <div class="container hero-inner">
    <div>
      {eyebrow && <span class="eyebrow" data-tina-field={f("eyebrow")}>{eyebrow}</span>}
      <h1 data-tina-field={f("heading")}>{heading}</h1>
      <div class="hero-cta">
        {ctaPrimaryLabel && <a href={ctaPrimaryHref} class="btn btn-primary btn-lg" data-tina-field={f("ctaPrimaryLabel")}>{ctaPrimaryLabel}</a>}
        {ctaSecondaryLabel && <a href={ctaSecondaryHref} class="btn btn-light btn-lg" data-tina-field={f("ctaSecondaryLabel")}>{ctaSecondaryLabel}</a>}
      </div>
      {stats && stats.length > 0 && (
        <div class="hero-stats">
          {stats.map((s: any) => (
            <div class="stat">
              <div class="n" data-tina-field={tinaField(s, "value")}>{s.value}</div>
              <div class="l" data-tina-field={tinaField(s, "label")}>{s.label}</div>
            </div>
          ))}
        </div>
      )}
    </div>
    {portrait && (
      <div class="hero-portrait">
        <img src={portrait} alt={portraitAlt} data-tina-field={f("portrait")} />
        {(badgeTop || badgeBottom) && (
          <div class="hero-badge">
            <div class="n" data-tina-field={f("badgeTop")}>{badgeTop}</div>
            <div class="l" data-tina-field={f("badgeBottom")}>{badgeBottom}</div>
          </div>
        )}
      </div>
    )}
  </div>
</section>
