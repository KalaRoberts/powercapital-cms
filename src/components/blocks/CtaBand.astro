---
export interface Props {
  heading?: string;
  body?: string;
  ctaLabel?: string;
  ctaHref?: string;
}
const { heading, body, ctaLabel, ctaHref } = Astro.props;
---
<section>
  <div class="container">
    <div class="cta-band reveal">
      {heading && <h2>{heading}</h2>}
      {body && <p>{body}</p>}
      {ctaLabel && (
        <div class="hero-cta">
          <a href={ctaHref} class="btn btn-primary btn-lg">{ctaLabel}</a>
        </div>
      )}
    </div>
  </div>
</section>
