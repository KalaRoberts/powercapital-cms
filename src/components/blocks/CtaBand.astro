---
import { tinaField } from "@tinacms/astro/tina-field";
const { heading, body, ctaLabel, ctaHref, block } = Astro.props as any;
const f = (name: string) => (block ? tinaField(block, name) : undefined);
---
<section>
  <div class="container">
    <div class="cta-band reveal">
      {heading && <h2 data-tina-field={f("heading")}>{heading}</h2>}
      {body && <p data-tina-field={f("body")}>{body}</p>}
      {ctaLabel && (
        <div class="hero-cta">
          <a href={ctaHref} class="btn btn-primary btn-lg" data-tina-field={f("ctaLabel")}>{ctaLabel}</a>
        </div>
      )}
    </div>
  </div>
</section>
