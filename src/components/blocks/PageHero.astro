---
import { tinaField } from "@tinacms/astro/tina-field";
import { inline } from "../../lib/inline";
const { heading, body, block, crumb } = Astro.props as any;
const f = (n: string) => (block ? tinaField(block, n) : undefined);
---
<section class="page-hero">
  <div class="container">
    {crumb && <div class="breadcrumb"><a href="/">{crumb.home}</a> / <span data-tina-field={crumb.field}>{crumb.page}</span></div>}
    {heading && <h1 data-tina-field={f("heading")}>{heading}</h1>}
    {body && <p data-tina-field={f("body")} set:html={inline(body)} />}
  </div>
</section>
