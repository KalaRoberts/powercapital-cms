---
import { tinaField } from "@tinacms/astro/tina-field";
import { inline } from "../../lib/inline";
const { eyebrow, heading, theme = "soft", items = [], block } = Astro.props as any;
const f = (n: string) => (block ? tinaField(block, n) : undefined);
const sectionClass = theme === "soft" ? "bg-soft" : theme === "mint" ? "bg-mint" : "";
---
<section class={sectionClass}>
  <div class="container">
    <div class="section-head center mx-auto">
      {eyebrow && <span class="eyebrow" data-tina-field={f("eyebrow")}>{eyebrow}</span>}
      {heading && <h2 data-tina-field={f("heading")}>{heading}</h2>}
    </div>
    <div style="max-width:820px;margin:0 auto">
      {(items ?? []).map((it: any) => (
        <div class="pillar reveal">
          <div class="num" data-tina-field={tinaField(it, "number")}>{it.number}</div>
          <div>
            <h3 data-tina-field={tinaField(it, "title")}>{it.title}</h3>
            <p data-tina-field={tinaField(it, "body")} set:html={inline(it.body)} />
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
