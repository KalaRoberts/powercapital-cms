---
import BaseLayout from "../layouts/BaseLayout.astro";
import TinaIsland from "@tinacms/astro/TinaIsland.astro";
import PageBlocks from "../components/PageBlocks.astro";
import { getPage } from "../lib/tina/data";
import { PAGE_WRAPPER } from "../lib/tina/islands";

const result = await getPage("credentials");
const page: any = result.data.page;
---
<BaseLayout
  title={page.title}
  description={page.description}
  path="/credentials"
  ogTitle={page.ogTitle}
  ogDescription={page.ogDescription}
  active="credentials"
>
  <TinaIsland name="page" wrapper={PAGE_WRAPPER} params={{ slug: "credentials" }} primary>
    <PageBlocks page={page} />
  </TinaIsland>
</BaseLayout>
