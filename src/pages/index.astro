---
import BaseLayout from "../layouts/BaseLayout.astro";
import TinaIsland from "@tinacms/astro/TinaIsland.astro";
import PageBlocks from "../components/PageBlocks.astro";
import { getPage } from "../lib/tina/data";
import { PAGE_WRAPPER } from "../lib/tina/islands";

const result = await getPage("home");
const home: any = result.data.page;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  name: "Power Capital",
  description:
    "Fractional CFO services providing executive financial architecture for data centers, construction, and real estate.",
  url: "https://powercapital.cloud",
  image: "https://powercapital.cloud/assets/img/og-cover.png",
  areaServed: "US",
  serviceType: [
    "Fractional CFO",
    "Financial Planning & Analysis",
    "Internal Audit & Controls",
    "Capital Raising",
    "Accounting Policy & Governance",
  ],
  knowsAbout: [
    "Data center finance",
    "Construction finance",
    "Real estate finance",
    "Capital stack modeling",
    "Draw schedules",
    "Financial covenants",
  ],
  founder: {
    "@type": "Person",
    name: "John Roberts",
    jobTitle: "President & Fractional CFO",
    sameAs: "https://www.linkedin.com/in/jmroberts67/",
  },
};
---
<BaseLayout
  title={home.title}
  description={home.description}
  path="/"
  ogTitle={home.ogTitle}
  ogDescription={home.ogDescription}
  active="home"
  jsonLd={jsonLd}
>
  <TinaIsland name="page" wrapper={PAGE_WRAPPER} params={{ slug: "home" }} primary>
    <PageBlocks page={home} />
  </TinaIsland>
</BaseLayout>
